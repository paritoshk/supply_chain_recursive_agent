# --- Crusoe inference (OpenAI-compatible) ---
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model per role (Nemotron on Crusoe serverless; blank = code default in packages/core/src/crusoe.ts).
# The verifier must differ from the planner/worker (judge != doer); it may later point at a self-serve alias.
MODEL_PLANNER=nvidia/NVIDIA-Nemotron-3.5-Super-VL
MODEL_WORKER=nvidia/NVIDIA-Nemotron-3.5-Super-VL
# Persona: Nano with thinking off measured p50 ~0.7 s vs Lightning ~1.0 s, both valid JSON.
MODEL_PERSONA=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_VERIFIER=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# "scripted" forces the deterministic offline supplier persona (tests set this automatically)
PERSONA_MODE=

# --- Live supplier discovery (You.com search) ---
YOU_DOT_COM_API_KEY=

# --- State persistence: one JSON blob ---
# Upstash Redis REST (key scos:state) is used when URL+TOKEN are set (KV_REST_API_URL/KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Otherwise a local file: STATE_FILE, else .data/state.json (or /tmp/supplier-chief-of-staff/state.json when VERCEL is set).
STATE_FILE=

# --- Telegram channel (@supplychief_bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Chat that receives proactive sentinel alerts (send /start to the bot, then read getUpdates)
TELEGRAM_CHAT_ID=

# --- State on Vercel: Upstash Redis (set automatically by the Vercel Upstash integration) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Cron + fault injection ---
CRON_SECRET=
# Comma-separated: persona_timeout,crusoe_429,bad_tool_json
FAULTS=
